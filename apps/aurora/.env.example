# Stripe (test mode). Dashboard -> Developers -> API keys.
STRIPE_SECRET_KEY=sk_test_replace_me

# Webhook signing secret.
# Local: the whsec_ printed by `stripe listen --forward-to localhost:3001/api/stripe/webhook`
# Production: Stripe Dashboard -> Developers -> Webhooks -> your endpoint
STRIPE_WEBHOOK_SECRET=whsec_replace_me

# Absolute origin for Stripe success/cancel URLs.
# Set on PRODUCTION ONLY, so preview deployments fall back to their own VERCEL_URL
# instead of sending buyers to the live site. Leave unset locally.
# NEXT_PUBLIC_SITE_URL=https://decorhbx.com
